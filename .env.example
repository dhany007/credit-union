DATABASE_URL=postgres:///credit_union?host=/var/run/postgresql
APP_ORIGIN=http://localhost:3000
API_ADDR=127.0.0.1:8080
COOKIE_SECURE=false
# 0 disables approval until the cooperative sets its authority limit.
# One initial rule: regular product, low risk, all KCPs, up to this amount.
APPROVAL_LIMIT_IDR=0
# Development only: at least 12 characters; no automatic production users.
DEV_SEED_PASSWORD=replace-with-a-long-local-password
