# Local Docker only. Copy to .env.docker; do not overwrite the WSL .env.
# Use a long random hexadecimal/alphanumeric database password (URL-safe).
POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-password
# At least 12 characters; used only by the explicit development seed command.
DEV_SEED_PASSWORD=replace-with-a-unique-local-password
WEB_PORT=3000
# Approval remains disabled until an authority limit is agreed.
APPROVAL_LIMIT_IDR=0
